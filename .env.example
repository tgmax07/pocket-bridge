# Codex Pocket configuration
CODEX_POCKET_PORT=8787

# The directory Codex is allowed to work in. Defaults to .\workspace.
# For a real project, point this at that project's folder.
CODEX_WORKDIR=C:\path\to\your\project

# Optional: expose more existing projects in the Codex Pocket project picker.
# Windows uses semicolons between paths.
# CODEX_PROJECTS=E:\AI\ProjectOne;D:\Work\ProjectTwo

# read-only | workspace-write | danger-full-access
CODEX_SANDBOX=workspace-write
# app-server: shared thread store; exec: isolated CLI fallback`nCODEX_TRANSPORT=app-server

# Optional: use a specific Codex executable.
# CODEX_BIN=C:\Users\you\AppData\Local\OpenAI\Codex\bin\codex.exe

# Optional: pin a pairing token. If omitted, one is generated in data\pairing-token.
# CODEX_POCKET_TOKEN=replace-with-a-long-random-string

# Optional: public URL shown in the UI when using your own named tunnel.
# CODEX_POCKET_PUBLIC_URL=https://codex.example.com




